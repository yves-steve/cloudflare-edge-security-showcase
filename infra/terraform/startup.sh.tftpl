#!/bin/bash
set -euo pipefail

SITE_DIR="/var/lib/edgeward/site"
NGINX_CONFIG="/var/lib/edgeward/nginx.conf"

mkdir -p "$SITE_DIR"
printf '%s' '${index_html_b64}' | base64 -d > "$SITE_DIR/index.html"
printf '%s' '${styles_css_b64}' | base64 -d > "$SITE_DIR/styles.css"
printf '%s' '${script_js_b64}' | base64 -d > "$SITE_DIR/script.js"
printf '%s' '${nginx_conf_b64}' | base64 -d > "$NGINX_CONFIG"
chmod -R 0755 /var/lib/edgeward

docker rm -f edgeward-site cloudflared >/dev/null 2>&1 || true

docker pull nginx:1.29-alpine
docker run --detach \
  --name edgeward-site \
  --network host \
  --restart unless-stopped \
  --read-only \
  --tmpfs /var/cache/nginx:rw,nosuid,nodev,size=16m \
  --tmpfs /var/run:rw,nosuid,nodev,size=1m \
  --volume "$SITE_DIR:/usr/share/nginx/html:ro" \
  --volume "$NGINX_CONFIG:/etc/nginx/conf.d/default.conf:ro" \
  nginx:1.29-alpine

readonly CLOUDFLARED_IMAGE='${cloudflared_image}'
docker pull "$CLOUDFLARED_IMAGE"
docker run --detach \
  --name cloudflared \
  --network host \
  --restart unless-stopped \
  "$CLOUDFLARED_IMAGE" \
  tunnel --no-autoupdate run --token '${tunnel_token}'
